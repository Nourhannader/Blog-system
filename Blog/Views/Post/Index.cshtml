<div class="modal fade" id="categoryModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-3">
            <div class="modal-header">
                <h5 class="modal-title">Add Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="categoryModalBody">
               
            </div>
        </div>
    </div>
</div>

@* //////////////////// *@

<div class="text-center m-3">
	@if (ViewBag.Categories != null)
	{
		@foreach(var category in ViewBag.Categories)
		{
			<a asp-controller="Post" asp-action="Index" asp-route-categoryId="@category.Id" class="badge bg-light text-decoration-none  ms-2">@category.Name</a>
		}
	}

</div>
@if (User.IsInRole("Admin"))
{
	<div class="text-end my-2">
		<a asp-action="Create" class="btn btn-primary rounded ">Create New Post</a>
	</div>
}
<div class="row row-cols-1 row-cols-md-3 g-4">
	@foreach(var post in Model)
	{
        <div class="col">
            <div class="card h-100 border-0 shadow-lg rounded-1">
                @* <div class="card h-100"> *@
                <!-- Display Image or Default Image -->
                <img src="@(!string.IsNullOrEmpty(post.FeatureImageUrl) ? "/images/" + post.FeatureImageUrl : "/images/default-image.jpg")"
                     class="card-img-top"
                     alt="@post.Title"
                     style="height: 300px; object-fit: cover;" />

                <div class="card-body">
                    <h5 class="card-title">@post.Title</h5>
                    <p class="text-muted mb-2">Published on @post.PublishedDate.ToString("MMMM dd, yyyy")</p>
                    <p class="card-text">
                        @(HtmlTagHelper.RemoveHtmlTags(post.Content).Length > 100 ? HtmlTagHelper.RemoveHtmlTags(post.Content).Substring(0, 100) + "..." : HtmlTagHelper.RemoveHtmlTags(post.Content))
                    </p>
                    <span class="badge bg-secondary">@post.Category?.Name</span>
                </div>

                <div class="card-footer d-flex justify-content-between align-items-center">
                    <a asp-action="Detail" asp-route-id="@post.Id" class="btn btn-primary btn-sm">Read More</a>
                    <div class="text-end">
                        <small class="text-muted">By @post.Author</small>
                    </div>
                </div>
            </div>
        </div>
	}
</div>
<script>
    document.getElementById('searchBox').addEventListener('input', function() {
        const query = this.value.toLowerCase();
        document.querySelectorAll('.post-item').forEach(post => {
            const title = post.dataset.title.toLowerCase();
            const content = post.dataset.content.toLowerCase();
            post.style.display = title.includes(query) || content.includes(query)
                ? 'block' : 'none';
        });
    });
</script>
<script>
    function openCategoryModal() {
        $.ajax({
            url: '@Url.Action("Create", "Category")',
            type: 'GET',
            success: function(result) {
                $("#categoryModalBody").html(result);
                $("#categoryModal").modal("show");
            }
        });
    }
</script>